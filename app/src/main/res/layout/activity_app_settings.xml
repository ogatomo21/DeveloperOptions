<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_settings_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- WRITE_SECURE_SETTINGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/settings_section_secure"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/secure_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#eeeeee"
                android:padding="12dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/open_permission_help_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_open_permission_help" />

            <!-- Mock location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/settings_section_mock_location"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_mock_location_body"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mock_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#eeeeee"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_mock_candidates"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/mock_app_list"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:choiceMode="singleChoice"
                android:divider="#dddddd"
                android:dividerHeight="1dp" />

            <TextView
                android:id="@+id/mock_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_mock_empty"
                android:textColor="#666666"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/mock_enable_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_mock_enable" />

            <Button
                android:id="@+id/mock_disable_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mock_disable" />

            <Button
                android:id="@+id/mock_refresh_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mock_refresh" />

            <TextView
                android:id="@+id/mock_hint_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/version_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
